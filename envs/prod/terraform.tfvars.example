# The reference for this environment's variables file. Copy it to the private
# repo as opentofu/prod.tfvars, which the ansible vms role reads, and fill in
# real values. variables.tf lists every key and its default.
#
# Addresses below are made-up examples from 172.16.0.0/16, not real hosts.
# API tokens do not go here. Set TF_VAR_server_api_tokens to a JSON object keyed
# like servers, or PROXMOX_VE_API_TOKEN when there is only one server.

servers = {
  # A standalone node. insecure skips the certificate check, only while the
  # API certificate is self-signed.
  vh01 = {
    endpoint     = "https://172.16.0.11:8006/"
    insecure     = true
    default_node = "vh01"
  }

  # A cluster, reached through its first node. installer_iso is shown with its
  # default. The ansible pve role puts that file on every node's local storage.
  cluster = {
    endpoint      = "https://172.16.0.12:8006/"
    default_node  = "vh02"
    installer_iso = "local:iso/fleet-nixos-installer.iso"
  }
}

# Keyed by the Ansible host's serverHostname in lower case. ipv4_address and
# ipv4_gateway must match the host in the inventory. site.yml stops if they
# do not.
vms = {
  # A standalone server has one node, so there is nothing to pin.
  example01 = {
    server         = "vh01"
    cores          = 2
    memory_mb      = 4096
    vlan_id        = 7
    ipv4_address   = "172.16.7.90/24"
    ipv4_gateway   = "172.16.7.1"
    dns_servers    = ["172.16.7.1"]
    tags           = ["docker"]
    os_disk_gb     = 20
    docker_disk_gb = 60

    # scsi2 is the persistent disk, mounted at /srv/persist. An install
    # formats it only when it is blank.
    extra_disks = {
      persist = { interface = "scsi2", size_gb = 100 }
    }
  }

  # Pinned: created on vh03, and moved back there if it is ever moved.
  # Without node_name it would be created on vh02 and then left wherever it
  # runs. The disks take their default sizes.
  example02 = {
    server       = "cluster"
    node_name    = "vh03"
    ipv4_address = "172.16.7.93/24"
    ipv4_gateway = "172.16.7.1"
  }
}
